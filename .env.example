# Optional API setting. Export it in your shell; no automatic .env loading.
MEDVISION_CHECKPOINT=artifacts/model.pt
# Optional: when set, S3 takes precedence over MEDVISION_CHECKPOINT.
# Download/validation errors fail startup; unset this to use the local checkpoint.
# MEDVISION_MODEL_S3_URI=s3://your-bucket/models/model.pt
# AWS_DEFAULT_REGION=eu-central-1
# Use the standard AWS credential chain / EC2 IAM role, never credentials in Git.
